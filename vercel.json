{
  "routes": [
    {
      "src": "/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/"
      },
      "continue": true
    },
    {
      "src": "/_expo/static/.+",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/[^.]*",
      "dest": "/index.html"
    }
  ]
}
